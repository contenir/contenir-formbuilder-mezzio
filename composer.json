{
    "name": "contenir/contenir-formbuilder-mezzio",
    "description": "Mezzio adapter for contenir/contenir-formbuilder: php-db form loader and entry store, PSR-15 submit handler, session CSRF and error stash, form renderer, and email, webhook and storage registrars.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "mezzio",
        "psr-15",
        "forms",
        "formbuilder"
    ],
    "authors": [
        {
            "name": "Contenir",
            "email": "hello@contenir.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-formbuilder": "^2.0",
        "laminas/laminas-form": "^3.20",
        "laminas/laminas-inputfilter": "^2.30",
        "laminas/laminas-validator": "^2.50 || ^3.0",
        "mezzio/mezzio": "^3.18",
        "mezzio/mezzio-router": "^3.17",
        "mezzio/mezzio-session": "^1.15",
        "mezzio/mezzio-template": "^2.10",
        "php-db/phpdb": "^0.6.0",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "contenir/contenir-storage": "^2.2",
        "infection/infection": "^0.34.1",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-servicemanager": "^3.22",
        "mezzio/mezzio-fastroute": "^3.12",
        "php-db/phpdb-sqlite": "^0.2.0",
        "phpunit/phpunit": "^11.5.42",
        "symfony/mailer": "^7.4.12 || ^8.0.12"
    },
    "suggest": {
        "contenir/contenir-storage": "Enables the file field type: register a Contenir\\Storage\\StorageManager service and uploads are stored on its default profile.",
        "mezzio/mezzio-session-ext": "Session persistence for the CSRF tokens and the validation-error stash (or any other mezzio-session persistence).",
        "symfony/mailer": "Enables email notifications: register a Symfony\\Component\\Mailer\\MailerInterface service (7.4.12 or later)."
    },
    "conflict": {
        "symfony/mailer": "<6.4.40 || >=7.0,<7.4.12 || >=8.0,<8.0.12",
        "symfony/mime": "<6.4.40 || >=7.0,<7.4.12 || >=8.0,<8.0.12"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\FormBuilder\\Mezzio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\FormBuilder\\Mezzio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laminas": {
            "config-provider": "Contenir\\FormBuilder\\Mezzio\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
